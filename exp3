import heapq
from collections import defaultdict
from typing import Dict, List, Tuple


class UnionFind:
    """Disjoint Set Union (DSU) data structure with path compression and rank optimization."""
    
    def __init__(self, n: int) -> None:
        self.parent = list(range(n))
        self.rank = [0] * n

    def find(self, x: int) -> int:
        if self.parent[x] != x:
            self.parent[x] = self.find(self.parent[x])  # Path compression
        return self.parent[x]

    def union(self, x: int, y: int) -> bool:
        rx, ry = self.find(x), self.find(y)
        if rx == ry:
            return False
        if self.rank[rx] < self.rank[ry]:
            rx, ry = ry, rx
        self.parent[ry] = rx
        if self.rank[rx] == self.rank[ry]:
            self.rank[rx] += 1
        return True


def kruskal(n: int, edges: List[Tuple[int, int, int]]) -> Tuple[List[Tuple[int, int, int]], int]:
    """
    Computes Minimum Spanning Tree using Kruskal's Algorithm.
    
    Args:
        n: Number of vertices.
        edges: List of tuples (weight, u, v).
        
    Returns:
        Tuple containing MST edges [(u, v, weight)...] and total cost.
    """
    sorted_edges = sorted(edges)  # Sort by weight O(E log E)
    uf = UnionFind(n)
    mst: List[Tuple[int, int, int]] = []
    cost = 0

    for w, u, v in sorted_edges:
        if uf.union(u, v):
            mst.append((u, v, w))
            cost += w
            if len(mst) == n - 1:
                break

    return mst, cost


def prim(n: int, adj: Dict[int, List[Tuple[int, int]]], start: int = 0) -> Tuple[List[Tuple[int, int, int]], int]:
    """
    Computes Minimum Spanning Tree using Prim's Algorithm.
    
    Args:
        n: Number of vertices.
        adj: Adjacency list mapping u -> list of (v, weight).
        start: Starting vertex.
        
    Returns:
        Tuple containing MST edges [(u, v, weight)...] and total cost.
    """
    in_mst = [False] * n
    mst: List[Tuple[int, int, int]] = []
    cost = 0

    # Priority queue stores tuples: (weight, current_node, parent_node)
    pq = [(0, start, -1)]

    while pq:
        w, u, parent = heapq.heappop(pq)
        
        if in_mst[u]:
            continue
            
        in_mst[u] = True
        
        if parent != -1:
            mst.append((parent, u, w))
            cost += w

        for v, wt in adj.get(u, []):
            if not in_mst[v]:
                heapq.heappush(pq, (wt, v, u))

    return mst, cost


def main() -> None:
    n = 7
    edges = [
        (7, 0, 1), (5, 0, 3), (8, 1, 2), (9, 1, 3),
        (7, 1, 4), (5, 2, 4), (15, 3, 4), (6, 3, 5),
        (8, 4, 5), (9, 4, 6), (11, 5, 6)
    ]

    # Build adjacency list for Prim's
    adj = defaultdict(list)
    for w, u, v in edges:
        adj[u].append((v, w))
        adj[v].append((u, w))

    k_mst, k_cost = kruskal(n, edges)
    p_mst, p_cost = prim(n, adj)

    print("=== Kruskal's MST ===")
    for u, v, w in k_mst:
        print(f"  Edge ({u} - {v})  Weight: {w}")
    print(f"  Total MST Cost: {k_cost}")

    print("\n=== Prim's MST ===")
    for u, v, w in p_mst:
        print(f"  Edge ({u} - {v})  Weight: {w}")
    print(f"  Total MST Cost: {p_cost}")


if __name__ == "__main__":
    main()